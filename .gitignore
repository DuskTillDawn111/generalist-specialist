# Source-first repository. Heavy assets remain in the local research workspace.
# Directories are traversable; only the file types below are included by default.
*
!*/
!*.py
!*.sh
!*.md
!*.toml
!*.yaml
!*.yml
!*.json
!*.py.txt
!LICENSE*
!NOTICE*
!requirements*.txt
!.gitignore
!.gitattributes

# Local environments, model/data assets, vendor caches, and editor state.
envs/
models/
datasets/
hf_cache/
pip_cache/
conda_pkgs/
cache/
wheels/
site-packages/
.module13b_tmp/
.vscode/
__pycache__/
.pytest_cache/
.venv/
venv/
download_logs/
.git/
*.egg-info/
.env
.env.*
*.pem
*.key

# Artifact JSON is opt-in. Executable .py/.sh and readable .md remain included.
/results/**/*.json
/benchmark/results/**/*.json

# Curated small catalogs, frozen protocol metadata, gates, profiles, and summaries.
# This is not a complete raw-data archive. See docs/reproduction.md.
